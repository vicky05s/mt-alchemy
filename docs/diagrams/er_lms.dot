digraph ER { rankdir=LR; dpi=200; nodesep=0.4; ranksep=0.8; bgcolor="white";
 node [shape=plaintext, fontname="Helvetica", fontsize=12];
 edge [color="#667085", fontname="Helvetica", fontsize=11, fontcolor="#7657A6", arrowsize=0.6, penwidth=1.3, dir=none];
 Course [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Course</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">course_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">instructor_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">price</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">level</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
 CourseModule [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>CourseModule</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">module_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">course_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">sort_order</TD></TR></TABLE>>];
 Lesson [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Lesson</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">lesson_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">module_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">content_type</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">content_url</TD></TR></TABLE>>];
 Assessment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Assessment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">assessment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">course_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">passing_score</TD></TR></TABLE>>];
 Question [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Question</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">question_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">assessment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">type</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">text</TD></TR></TABLE>>];
 Answer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Answer</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">answer_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">question_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">is_correct</TD></TR></TABLE>>];
 Enrolment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Enrolment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">enrolment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">course_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">assigned_by_org</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">deadline</TD></TR></TABLE>>];
 Progress [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Progress</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">progress_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">enrolment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">lesson_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">completed</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">percent</TD></TR></TABLE>>];
 Certificate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Certificate</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">certificate_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">enrolment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">issue_date</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">verify_code</TD></TR></TABLE>>];
 Review [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Review</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">review_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">course_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">rating</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">comment</TD></TR></TABLE>>];
 User [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR></TABLE>>];
 Course -> CourseModule [label="1:N"];
 CourseModule -> Lesson [label="1:N"];
 Course -> Assessment [label="1:N"];
 Assessment -> Question [label="1:N"];
 Question -> Answer [label="1:N"];
 User -> Enrolment [label="1:N"];
 Course -> Enrolment [label="1:N"];
 Enrolment -> Progress [label="1:N"];
 Lesson -> Progress [label="1:N"];
 Enrolment -> Certificate [label="1:1"];
 User -> Review [label="1:N"];
 Course -> Review [label="1:N"];
 User -> Course [label="1:N"];
}
