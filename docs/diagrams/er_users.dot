digraph ER { rankdir=LR; dpi=200; nodesep=0.4; ranksep=0.8; bgcolor="white";
 node [shape=plaintext, fontname="Helvetica", fontsize=12];
 edge [color="#667085", fontname="Helvetica", fontsize=11, fontcolor="#7657A6", arrowsize=0.6, penwidth=1.3, dir=none];
 Role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Role</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">role_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">role_name</TD></TR></TABLE>>];
 User [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">role_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">email</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">password_hash</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">phone</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">country</TD></TR></TABLE>>];
 Organization [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Organization</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">org_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">owner_user_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">org_name</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">industry</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">reg_no</TD></TR></TABLE>>];
 Employee [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Employee</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">employee_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">org_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">department</TD></TR></TABLE>>];
 Notification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Notification</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">notification_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">message</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">is_read</TD></TR></TABLE>>];
 Article [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Article</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">article_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">author_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">category</TD></TR></TABLE>>];
 Role -> User [label="1:N"];
 User -> Organization [label="1:N"];
 Organization -> Employee [label="1:N"];
 User -> Employee [label="1:1"];
 User -> Article [label="1:N"];
 User -> Notification [label="1:N"];
}
