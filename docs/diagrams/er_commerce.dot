digraph ER { rankdir=LR; dpi=200; nodesep=0.4; ranksep=0.8; bgcolor="white";
 node [shape=plaintext, fontname="Helvetica", fontsize=12];
 edge [color="#667085", fontname="Helvetica", fontsize=11, fontcolor="#7657A6", arrowsize=0.6, penwidth=1.3, dir=none];
 ProductCategory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>ProductCategory</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">category_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">name</TD></TR></TABLE>>];
 Product [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Product</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">product_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">category_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">price</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">type</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">stock</TD></TR></TABLE>>];
 Cart [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Cart</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">cart_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">product_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">quantity</TD></TR></TABLE>>];
 Order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">order_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">total</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
 OrderItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>OrderItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">item_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">order_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">product_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">quantity</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">unit_price</TD></TR></TABLE>>];
 Payment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Payment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">payment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">order_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">method</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">state</TD></TR></TABLE>>];
 Shipping [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>Shipping</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">shipping_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">order_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">address</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
 DigitalDownload [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>DigitalDownload</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">download_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">order_item_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"></TD><TD ALIGN="LEFT">file_url</TD></TR></TABLE>>];
 User [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#172A4D"><TR><TD COLSPAN="2" BGCOLOR="#172A4D"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="24"><FONT COLOR="#7657A6"><B>PK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR></TABLE>>];
 ProductCategory -> Product [label="1:N"];
 User -> Cart [label="1:N"];
 Product -> Cart [label="1:N"];
 User -> Order [label="1:N"];
 Order -> OrderItem [label="1:N"];
 Product -> OrderItem [label="1:N"];
 Order -> Payment [label="1:N"];
 Order -> Shipping [label="1:1"];
 OrderItem -> DigitalDownload [label="1:N"];
}
